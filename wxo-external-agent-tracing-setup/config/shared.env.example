# =============================================================================
# config/shared.env.example  —  WXO Platform Credentials Shared Across Platforms
# =============================================================================
# Copy this file to config/shared.env and fill in your values:
#   cp config/shared.env.example config/shared.env
#
# What belongs here:
#   API_KEY    — WXO API key used to exchange for a bearer token
#   TOKEN_URL  — IBM IAM endpoint for the API key → bearer token exchange
#
# What belongs in platform files (config/aws.env, config/azure.env, etc.):
#   WXO_OTEL_EXPORT_URL, ENVIRONMENT_NAME, WXO_AGENT_MAP
# =============================================================================

export WXO_DEPLOYMENT_MODE="cloud"      # cloud | cpd
export API_KEY="<your-wxo-api-key>"
export TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"

# =============================================================================
# config/aws.env.example  —  AWS AgentCore Configuration
# =============================================================================
# Copy this file to config/aws.env and fill in your values:
#   cp config/aws.env.example config/aws.env
#
# Commands:
#   ./src/aws/ssm_params.sh             # run once to store WXO credentials in SSM
#   ./wire_agent.sh --aws --harness     # Flow A: Harness (env vars only)
#   ./wire_agent.sh --aws --runtime     # Flow B: Runtime (image patch)
#   ./wire_agent.sh --aws --dry-run     # validate configuration without changes
# =============================================================================

# ── AWS Authentication ────────────────────────────────────────────────────────
# If you use `aws configure` or AWS_PROFILE, leave these blank.
export AWS_ACCESS_KEY_ID="<your-aws-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<your-aws-secret-access-key>"
# export AWS_SESSION_TOKEN=""           # uncomment for SSO / temporary credentials

# ── AWS Target Region & Account ───────────────────────────────────────────────
export AWS_REGION="us-east-1"
export AWS_DEFAULT_REGION="${AWS_REGION}"
export AWS_ACCOUNT_ID="<your-aws-account-id>"

# ── Flow Selection ────────────────────────────────────────────────────────────
# AGENT_TYPE: "harness" → Flow A (env vars only, no Docker, no image change)
#             "runtime" → Flow B (sitecustomize.py patched into ECR image)
export AGENT_TYPE="harness"

# ── WXO Platform Credentials ──────────────────────────────────────────────────
export WXO_DEPLOYMENT_MODE="cloud"      # cloud | cpd
export API_KEY="<your-wxo-api-key>"
export TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
export WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
# WXO_TENANT_ID is extracted automatically from WXO_OTEL_EXPORT_URL
export ENVIRONMENT_NAME="draft"         # draft | live

# ── Agent Mapping (required) ──────────────────────────────────────────────────
# One or many agents. Each key is an AGENT_REF (harness ID or runtime ID).
export WXO_AGENT_MAP='{
  "default": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "AWS Agent"
  }
}'

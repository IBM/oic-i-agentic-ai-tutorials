# =============================================================================
# UNIFIED PLATFORM CONFIGURATION TEMPLATE (config.env)
# =============================================================================
#
# Configure all platforms and WXO credentials in this single file.
# Each section contains all WXO credentials, agent maps, and cloud settings
# needed for that specific platform.
#
# Quick start:
#   cp config.env.example config.env
#
# ── QUICK JUMP / TABLE OF CONTENTS ───────────────────────────────────────────
# Search (Ctrl+F / Cmd+F or '/' in vi/nano) for any section tag below:
#
#   → Search [claude]      Claude (OTLP Forwarder on Docker/Lambda/Azure)
#   → Search [aws]         AWS AgentCore / Bedrock Agents
#   → Search [azure]       Azure AI Foundry Agents
#   → Search [vertex]      Google Cloud Vertex AI / Reasoning Engine
#   → Search [salesforce]  Salesforce Agentforce / Data 360
#
# ── DEPLOYMENT MODE: cloud (IBM Cloud SaaS) vs cpd (on-prem Cloud Pak for Data)
# Set WXO_DEPLOYMENT_MODE per section (default: cloud). The mode decides HOW the
# WXO bearer token is generated and WHERE traces are posted:
#
#   cloud  API_KEY is exchanged at TOKEN_URL (IBM IAM).
#          Needs: API_KEY, TOKEN_URL, WXO_OTEL_EXPORT_URL, ENVIRONMENT_NAME
#          (WXO_TENANT_ID is extracted automatically from WXO_OTEL_EXPORT_URL).
#          Sends x-ibm-tenant-id / x-tenant-id headers.
#
#   cpd    CPD_USERNAME + CPD_PASSWORD are exchanged at
#          <CPD_HOST_URL>/icp4d-api/v1/authorize (token cached ~12h).
#          Needs: CPD_HOST_URL, CPD_USERNAME, CPD_PASSWORD, CPD_INSTANCE_ID,
#                 CPD_NAMESPACE, ENVIRONMENT_NAME
#          Export URL is derived automatically:
#            <CPD_HOST_URL>/<CPD_NAMESPACE>/instances/<CPD_INSTANCE_ID>/v1/agentops-v3/traces
#          (override with CPD_EXPORT_URL or WXO_OTEL_EXPORT_URL).
#          No tenant ID / API_KEY / TOKEN_URL needed. TLS verification is
#          skipped (self-signed certs) unless CPD_VERIFY_TLS="true".
#          Salesforce (cpd): the --apex flow calls CPD from inside the Salesforce
#          org, so CPD_HOST_URL must be reachable from the public internet with a
#          CA-trusted TLS cert (Apex cannot skip verification). For a private /
#          self-signed CPD use the external --poller flow instead.
#
# ── CLI COMMANDS ─────────────────────────────────────────────────────────────
#   ./wire_agent.sh --status             # View configuration readiness table
#   ./wire_agent.sh --show <platform>    # View config for specific platform
#   ./wire_agent.sh --<platform>         # Run platform
#   ./wire_agent.sh --<platform> --dry-run # Validate without changes
# =============================================================================


# =============================================================================
# [claude] — Claude tracing via the OTLP Trace Forwarder
# =============================================================================
# ./claude.sh deploys the forwarder (aws | azure | docker), then
# points Claude's OTel destination at the forwarder URL (or prints the URL if
# no ANTHROPIC_ADMIN_API_KEY is set). The forwarder receives standard OTLP/HTTP
# traces, enriches them with WXO identities and routes them to watsonx Orchestrate.
# =============================================================================
[claude]
# ── WXO Credentials ──────────────────────────────────────────────────────────
WXO_DEPLOYMENT_MODE="cloud"    # cloud | cpd
ENVIRONMENT_NAME="draft"       # draft | live

# cloud mode (IBM Cloud SaaS):
API_KEY="<your-wxo-api-key>"
TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
# WXO_TENANT_ID is extracted automatically from WXO_OTEL_EXPORT_URL

# cpd mode (on-prem Cloud Pak for Data) — set WXO_DEPLOYMENT_MODE="cpd" and use:
# CPD_HOST_URL="https://cpd-<namespace>.apps.<cluster-domain>"
# CPD_USERNAME="<cpd-username>"
# CPD_PASSWORD="<cpd-password>"
# CPD_INSTANCE_ID="<wxo-instance-id>"
# CPD_NAMESPACE="<cpd-namespace>"      # e.g. cpd-instance
# CPD_VERIFY_TLS="false"               # optional; true to verify certs
# CPD_EXPORT_URL=""                    # optional full export URL override

# ── Agent Mapping ────────────────────────────────────────────────────────────
# Maps agent keys, service names, model names, or IDs to WXO agent UUIDs.
# Resolution order: URL path (/v1/traces/<key>) → ?agent_id= param →
# x-agent-id header → span attribute agent.id / gen_ai.agent.id → exact key match → "default"
WXO_AGENT_MAP='{
  "default": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Default Fallback Agent"
  },
  "my-claude-agent": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Claude Agent"
  },
  "customer-support-bot": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Customer Support Agent",
    "wxo_tenant_id":    "<optional-different-tenant-id>",
    "environment":      "live"
  }
}'

# ── WHERE the Forwarder Runs ─────────────────────────────────────────────────
FORWARDER_TARGET="docker"      # aws | azure | docker  (leave empty to be asked at deploy time)
OTLP_PORT="4318"               # Local / Docker listening port
FORWARDER_AUTH_TOKEN=""        # Optional: require 'Authorization: Bearer <token>'

# ── Claude (Anthropic OTel destination) ──────────────────────────────────────
# ./claude.sh deploys the forwarder, reads its URL, then:
#   ANTHROPIC_ADMIN_API_KEY set   → creates/updates the Anthropic OTel destination
#   ANTHROPIC_ADMIN_API_KEY unset → prints the URL for you to set in Claude's OTel settings
# Anthropic needs a public https forwarder (aws / azure target, or FORWARDER_URL).
# Keep the admin key out of files: export ANTHROPIC_ADMIN_API_KEY in your shell instead.
# ANTHROPIC_ADMIN_API_KEY="<sk-ant-admin...>"
# ANTHROPIC_WORKSPACE_ID="<wrkspc_...>"      # comma-separated IDs, or "all"
# ANTHROPIC_DESTINATION_NAME=""              # optional; default "watsonx Orchestrate - Agent Analytics (OTLP forwarder)"
# ANTHROPIC_CONTENT_MODE="content"           # "content" (full prompt & completions) or "metadata_only"
# FORWARDER_URL=""                           # optional override, e.g. https://host (no /v1/traces)

# ── Target: Docker Settings ──────────────────────────────────────────────────
DOCKER_IMAGE_NAME="wxo-otlp-forwarder"
DOCKER_CONTAINER_NAME="wxo-otlp-forwarder"

# ── Target: AWS Lambda Settings (when FORWARDER_TARGET="aws") ─────────────────
AWS_REGION="us-east-1"
# AWS_LAMBDA_FUNCTION_NAME="wxo-otlp-forwarder-claude"          # optional; default shown. Letters, digits, - and _ only (max 64)
SSM_SETTINGS_PATH="/wxo-agent/settings"
SSM_AGENT_MAP_PATH="/wxo-agent/agent_map"
# Prefer AWS CLI profile / login. Set explicit keys only if required:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ACCOUNT_ID=""

# ── Target: Azure Functions Settings (when FORWARDER_TARGET="azure") ──────────
# AZURE_FORWARDER_APP_NAME="wxo-otlp-forwarder"
# AZURE_RESOURCE_GROUP="wxo-tracing-rg"
# AZURE_LOCATION="eastus"
# AZURE_STORAGE_ACCOUNT=""


# =============================================================================
# [aws] — AWS AgentCore / Bedrock Agents
# =============================================================================
# Flow A (--harness): Injects OTEL_* env vars into AWS-managed Harness images.
# Flow B (--runtime): Patches user container image with sitecustomize.py.
# =============================================================================
[aws]
# ── WXO Credentials ──────────────────────────────────────────────────────────
WXO_DEPLOYMENT_MODE="cloud"    # cloud | cpd
ENVIRONMENT_NAME="draft"       # draft | live

# cloud mode (IBM Cloud SaaS):
API_KEY="<your-wxo-api-key>"
TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
# WXO_TENANT_ID is extracted automatically from WXO_OTEL_EXPORT_URL

# cpd mode (on-prem Cloud Pak for Data) — set WXO_DEPLOYMENT_MODE="cpd" and use:
# CPD_HOST_URL="https://cpd-<namespace>.apps.<cluster-domain>"
# CPD_USERNAME="<cpd-username>"
# CPD_PASSWORD="<cpd-password>"
# CPD_INSTANCE_ID="<wxo-instance-id>"
# CPD_NAMESPACE="<cpd-namespace>"
# CPD_VERIFY_TLS="false"

# ── Agent Mapping ────────────────────────────────────────────────────────────
# Each key is an AGENT_REF (harness ID or runtime ID).
WXO_AGENT_MAP='{
  "harness_hmhcq-FGWZ2OHwpG": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "AWS Bedrock Agent"
  }
}'

# ── AWS Settings ─────────────────────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCOUNT_ID="<your-aws-account-id>"
AGENT_TYPE="harness"           # harness (Flow A) | runtime (Flow B)

# Optional AWS credentials (leave commented if using AWS CLI / SSO):
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""


# =============================================================================
# [azure] — Azure AI Foundry Agents
# =============================================================================
# Deploys Azure Function App polling Log Analytics (every 5s).
# Covers all prompt and hosted agents in the workspace.
# =============================================================================
[azure]
# ── WXO Credentials ──────────────────────────────────────────────────────────
WXO_DEPLOYMENT_MODE="cloud"    # cloud | cpd
ENVIRONMENT_NAME="draft"       # draft | live

# cloud mode (IBM Cloud SaaS):
API_KEY="<your-wxo-api-key>"
TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
# WXO_TENANT_ID is extracted automatically from WXO_OTEL_EXPORT_URL

# cpd mode (on-prem Cloud Pak for Data) — set WXO_DEPLOYMENT_MODE="cpd" and use:
# CPD_HOST_URL="https://cpd-<namespace>.apps.<cluster-domain>"
# CPD_USERNAME="<cpd-username>"
# CPD_PASSWORD="<cpd-password>"
# CPD_INSTANCE_ID="<wxo-instance-id>"
# CPD_NAMESPACE="<cpd-namespace>"
# CPD_VERIFY_TLS="false"

# ── Agent Mapping ────────────────────────────────────────────────────────────
# Each key is the exact Azure AI Foundry agent name.
WXO_AGENT_MAP='{
  "my-foundry-agent": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Azure Foundry Agent"
  }
}'

# ── Azure Subscription & Location ────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID="<your-azure-subscription-id>"
AZURE_RESOURCE_GROUP="<your-azure-resource-group>"
AZURE_LOCATION="eastus"

# ── AI Foundry Account & Project ──────────────────────────────────────────────
AZURE_ACCOUNT="<your-ai-foundry-account>"
AZURE_PROJECT="<your-ai-foundry-project>"

# ── Log Analytics & Function App Settings ─────────────────────────────────────
LOG_ANALYTICS_WORKSPACE_ID="<your-log-analytics-workspace-id>"
LOG_ANALYTICS_WORKSPACE_NAME="<your-log-analytics-workspace-name>"
FUNCTION_APP_NAME="wxo-foundry-prompt-tracer"
STORAGE_ACCOUNT_NAME="<unique-storage-account-name>"

# ── Optional: Container Apps Settings ────────────────────────────────────────
AZURE_CONTAINER_REGISTRY=""
AZURE_CONTAINER_ENV="wxo-agents-env"


# =============================================================================
# [vertex] — Google Cloud Vertex AI / Reasoning Engine
# =============================================================================
# Flow A (--selfhosted): Injects sitecustomize.py into Cloud Run / GKE container.
# Flow B (--reasoning-engine): Embeds WXO tracing in Reasoning Engine query().
# =============================================================================
[vertex]
# ── WXO Credentials ──────────────────────────────────────────────────────────
WXO_DEPLOYMENT_MODE="cloud"    # cloud | cpd
ENVIRONMENT_NAME="draft"       # draft | live

# cloud mode (IBM Cloud SaaS):
API_KEY="<your-wxo-api-key>"
TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
# WXO_TENANT_ID is extracted automatically from WXO_OTEL_EXPORT_URL

# cpd mode (on-prem Cloud Pak for Data) — set WXO_DEPLOYMENT_MODE="cpd" and use:
# CPD_HOST_URL="https://cpd-<namespace>.apps.<cluster-domain>"
# CPD_USERNAME="<cpd-username>"
# CPD_PASSWORD="<cpd-password>"
# CPD_INSTANCE_ID="<wxo-instance-id>"
# CPD_NAMESPACE="<cpd-namespace>"
# CPD_VERIFY_TLS="false"

# ── Agent Mapping ────────────────────────────────────────────────────────────
# Key is Reasoning Engine ID (Flow B) or Cloud Run service name (Flow A).
WXO_AGENT_MAP='{
  "my-vertex-agent": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "source_image":     "us-central1-docker.pkg.dev/<project>/<repo>/<agent>:latest"
  }
}'

# ── GCP Settings ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID="<your-gcp-project-id>"
GCP_REGION="us-central1"
# GCP Service Account Credentials: accepts base64-encoded JSON, direct raw JSON string, or local file path
GOOGLE_APPLICATION_CREDENTIALS="<base64-encoded-json-or-raw-json-or-file-path>"
GCP_ARTIFACT_REGISTRY=""
CONTAINER_TARGET="cloudrun"   # cloudrun | artifact


# =============================================================================
# [salesforce] — Salesforce Agentforce / Data 360
# =============================================================================
# Flow A (--apex): Deploys in-org WxoSessionPoller Queueable stack + REST endpoint.
# Flow B (--poller): Runs external Python poller daemon.
# =============================================================================
[salesforce]
# ── WXO Credentials ──────────────────────────────────────────────────────────
WXO_DEPLOYMENT_MODE="cloud"    # cloud | cpd
ENVIRONMENT_NAME="draft"       # draft | live

# cloud mode (IBM Cloud SaaS):
API_KEY="<your-wxo-api-key>"
TOKEN_URL="https://account-iam.platform.saas.ibm.com/api/2.0/apikeys/token"
WXO_OTEL_EXPORT_URL="https://api.watson-orchestrate.ibm.com/instances/<instance-id>/v1/orchestrate/inject/traces"
# WXO_TENANT_ID is extracted automatically from WXO_OTEL_EXPORT_URL

# cpd mode (on-prem Cloud Pak for Data) — set WXO_DEPLOYMENT_MODE="cpd" and use:
# CPD_HOST_URL="https://cpd-<namespace>.apps.<cluster-domain>"
# CPD_USERNAME="<cpd-username>"
# CPD_PASSWORD="<cpd-password>"
# CPD_INSTANCE_ID="<wxo-instance-id>"
# CPD_NAMESPACE="<cpd-namespace>"
# CPD_VERIFY_TLS="false"               # --poller only; Apex always verifies TLS

# ── Agent Mapping ────────────────────────────────────────────────────────────
# Keys must match BotDefinition.DeveloperName in Salesforce.
WXO_AGENT_MAP='{
  "Agentforce_Bot_Dev_Name": {
    "wxo_agent_id":     "<your-wxo-agent-uuid>",
    "wxo_display_name": "Salesforce Agentforce"
  }
}'

# ── Salesforce Settings ──────────────────────────────────────────────────────
# Preferred auth: sf CLI target org alias or username (sf org display --target-org <alias>)
SF_TARGET_ORG="my-org"
SF_API_VERSION="68.0"
SF_POLL_INTERVAL_SEC="60"

# Optional direct credentials (used if sf CLI auth is not present):
SF_INSTANCE_URL=""
SF_ORG_ID=""
SF_USERNAME=""
SF_LOGIN_URL="https://login.salesforce.com"
SF_PASSWORD=""
SF_SECURITY_TOKEN=""
SF_CLIENT_ID=""
SF_CLIENT_SECRET=""

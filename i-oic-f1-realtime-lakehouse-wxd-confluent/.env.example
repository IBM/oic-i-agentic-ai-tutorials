# ---------------------------------------------------------------------------
# F1 lakehouse tutorial: copy to .env and fill in your values.  cp .env.example .env
# .env is in .gitignore. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- IBM watsonx.data (Step 2) ---
WXD_HOST=https://us-south.lakehouse.cloud.ibm.com
WXD_CRN=crn:v1:bluemix:public:lakehouse:<region>:a/<account-id>:<instance-id>::
WXD_API_KEY=<your IBM Cloud API key>
# Presto user: ibmlhapikey_ followed by the email of the API key's owner
WXD_USER=ibmlhapikey_<your-ibm-cloud-email>
PRESTO_ENGINE_ID=<presto engine id, for example presto604>
PRESTO_HOST=<presto engine public host name>
SPARK_ENGINE_ID=<spark engine id, for example spark293>
ICEBERG_CATALOG=<iceberg catalog name, for example iceberg_data_<instance-id>>
# The bucket behind the Iceberg catalog (the Iceberg warehouse)
COS_BUCKET=<watsonx.data bucket, for example do-not-delete-wxdata-<instance-id>>
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud

# --- Landing bucket + HMAC keys for Spark (Step 3) ---
LANDING_BUCKET=<your landing bucket>
LANDING_HMAC_ACCESS_KEY_ID=<cos_hmac_keys.access_key_id>
LANDING_HMAC_SECRET_ACCESS_KEY=<cos_hmac_keys.secret_access_key>

# --- Confluent Cloud (Step 8) ---
KAFKA_BOOTSTRAP=<pkc-xxxxx.<region>.<cloud>.confluent.cloud:9092>
KAFKA_API_KEY=<Confluent cluster API key>
KAFKA_API_SECRET=<Confluent cluster API secret>
KAFKA_TOPIC=f1.race.results

# --- Neon PostgreSQL (Step 11) ---
NEON_PG_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- IBM watsonx Orchestrate (Step 12) ---
WXO_INSTANCE_URL=https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WXO_API_KEY=<your watsonx Orchestrate API key>

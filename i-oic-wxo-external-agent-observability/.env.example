# ---------------------------------------------------------------------------
# Gemini / Google ADK credentials
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=<gemini-api-key>

# ---------------------------------------------------------------------------
# wxO telemetry — read by wxo_otel.py (WxoA2ATraceMiddleware)
# WXO_API_KEY is intentionally distinct from GOOGLE_API_KEY so the two SDKs
# never collide on the same environment variable name.
# ---------------------------------------------------------------------------
WXO_API_KEY=<wxo-api-key-authorized-for-target-tenant>

WXO_AGENT_ID=<registered-external-agent-id>
WXO_AGENT_NAME=external_order_support_agent
WXO_AGENT_DISPLAY_NAME=Langgrah-Agent
WXO_TENANT_ID=<account-id>_<instance-id>

# live | draft
ENVIRONMENT_NAME=live

TOKEN_URL=<mcsp-or-iam-token-endpoint>
OTEL_EXPORT_URL=<wxo-instance-url>/v1/orchestrate/inject/traces

OTEL_SERVICE_NAME=<otel-service-name>
OTEL_SERVICE_VERSION=2.0.0

# Set to false to stop request/response content from being stored in traces
WXO_CAPTURE_CONTENT=true
